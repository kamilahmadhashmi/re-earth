{
  "name": "re-earth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "audit:slop": "node ../anti-ai-tools/avoid-ai-design/scripts/detect.mjs src/",
    "lint:ui": "python ../anti-ai-tools/anti-ai-slop-ui/scripts/ui_lint.py src/",
    "validate:trees": "node scripts/validate_trees.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/audit_a11y.mjs",
    "test:visual": "node scripts/visual_regression.mjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:unused": "knip",
    "monitor:aws": "python scripts/cloudwatch_probe.py",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.6",
    "@react-three/postprocessing": "^2.16.2",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.1.7",
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.378.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@rollup/pluginutils": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/leaflet": "^1.9.22",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.5.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
